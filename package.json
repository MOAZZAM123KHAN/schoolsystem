{
  "name": "schoolsystem",
  "version": "1.0.0",
  "private": true,
  "description": "Progress Report Card Maker - frontend + backend monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npx vite build frontend",
    "start": "npm run start -w backend"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "vite": "^8.3.6"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
